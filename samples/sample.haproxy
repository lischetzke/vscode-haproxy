.if version_atleast(3.0) && defined(HAPROXY_LOCALPEER)
    .notice "running on ${HAPROXY_LOCALPEER}"
.else
    .alert "too old"
.endif

global
    log stdout format raw local0 info
    nbthread 4
    tune.ssl.default-dh-param 2048
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    setenv BACKEND_IP 10.0.0.10

defaults base
    mode http
    timeout client 30s
    option httplog
    no option http-server-close

resolvers dns
    nameserver ns1 1.1.1.1:53
    hold valid 10s

userlist admins
    user alice password $6$saltsalt$hash groups ops

frontend fe_main from base
    bind :443,[::]:443 ssl crt /etc/haproxy/certs/ alpn h2,http/1.1
    bind ipv6@:::80 v4v6
    bind unix@/run/haproxy/fe.sock
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }
    http-request set-header X-Real-IP %[src]
    http-request deny deny_status 403 if !{ src -f /etc/haproxy/allow.lst } || { path_beg -i /admin }
    http-request return status 200 content-type text/plain string "ok" if { path /health }
    acl api hdr(host) -i -m dom api.example.com
    acl rate_abuse sc0_http_req_rate gt 100
    capture request header Host len 64
    log-format "%ci:%cp [%tr] %ft %b/%s %ST %B %{+Q}r"
    use_backend %[req.hdr(host),lower,map_dom(maps/hosts.map,be_default)]
    use_backend be_api if api
    default_backend be_default

backend be_api
    balance roundrobin
    option httpchk
    http-check send meth GET uri /health ver HTTP/1.1 hdr Host api.example.com
    http-check expect status 200
    stick-table type ipv6 size 100k expire 30m store conn_cur,http_req_rate(10s)
    server api1 "${BACKEND_IP}":8080 check inter 2s rise 2 fall 3 weight 100
    server api2 2001:db8::10:8080 check backup
    server-template web 1-5 _http._tcp.svc.local resolvers dns init-addr none

listen stats
    bind 127.0.0.1:8404
    stats enable
    stats uri /stats
    stats refresh 10s
